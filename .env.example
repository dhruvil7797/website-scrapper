# Cloudflare (Pages, D1, R2)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_R2_BUCKET=client-scraper-assets

# Google Places API (comma-separated keys for rotation)
GOOGLE_API_KEYS=key1,key2,key3

# SMTP (Purelymail or any SMTP provider)
PURELYMAIL_SMTP_HOST=smtp.purelymail.com
PURELYMAIL_SMTP_PORT=465
PURELYMAIL_SMTP_USER=you@yourdomain.com
PURELYMAIL_SMTP_PASS=your_smtp_password
SENDING_EMAIL=you@yourdomain.com
REPLY_TO_EMAIL=contact@yourdomain.com
BCC_EMAIL=archive@yourdomain.com
SENDING_DOMAIN=yourdomain.com

# Portfolio site (where generated sites are hosted)
PORTFOLIO_DOMAIN=preview.yourdomain.com

# Admin panel
ADMIN_PASSWORD=changeme

# Gemini API (used by generator for content)
GEMINI_API_KEY=your_gemini_api_key
